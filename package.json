{
  "name": "@tinyforge/dsh-plugin-manager-wj",
  "version": "1.3.3",
  "description": "Switchable plugin, configuration, skill and MCP views with health diagnostics, configuration provenance, and tool/MCP inventory for DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "scripts": { "test": "node --test" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "README.md", "README.zh.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "repository": { "type": "git", "url": "git+https://github.com/phoenixlucky/dsh-plugin-manager-wj.git" },
  "homepage": "https://github.com/phoenixlucky/dsh-plugin-manager-wj#readme",
  "bugs": { "url": "https://github.com/phoenixlucky/dsh-plugin-manager-wj/issues" },
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "plugin-manager", "mcp", "skills", "cordis"],
  "peerDependencies": { "@deepseek-ai/cordis": "*" },
  "license": "MIT"
}
