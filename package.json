{
  "name": "@tinyforge/dsh-plugin-manager-wj",
  "version": "1.7.0",
  "description": "Plugin health, configuration provenance, skill catalog and tool-ownership views for DeepSeek Harness; MCP server management is recommended through @tinyforge/dsh-mcp-settings.",
  "type": "module",
  "main": "index.js",
  "icon": "icon.webp",
  "scripts": { "test": "node --test" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.webp",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "icon.webp", "locale/*.json", "README.md", "README.zh.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "repository": { "type": "git", "url": "git+https://github.com/phoenixlucky/dsh-plugin-manager-wj.git" },
  "homepage": "https://github.com/phoenixlucky/dsh-plugin-manager-wj#readme",
  "bugs": { "url": "https://github.com/phoenixlucky/dsh-plugin-manager-wj/issues" },
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "plugin-manager", "mcp", "skills", "cordis"],
  "peerDependencies": { "@deepseek-ai/cordis": "*" },
  "license": "MIT"
}
